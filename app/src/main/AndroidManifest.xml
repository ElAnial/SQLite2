<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Ubicación del dispositivo (Informe de Stock: ruta hacia la empresa) -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.SQLite">

        <!-- Splash / Portada (Punto de entrada / Launcher) -->
        <activity
            android:name=".SplashActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Actividad de Login (se abre después del Splash) -->
        <activity
            android:name=".LoginActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <!-- Dashboard Principal -->
        <activity
            android:name=".MainActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <!-- Módulo de Productos e Inventario -->
        <activity
            android:name=".ProductosActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <!-- Detalle, Edición y Registro de Productos -->
        <activity
            android:name=".EditarProductoActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <!-- Entradas de stock -->
        <activity
            android:name=".SalidasActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <activity
            android:name=".EntradasActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <!-- Módulo de Categorías -->
        <activity
            android:name=".CategoriasActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <!-- Módulo de Gestión de Usuarios y Roles -->
        <activity
            android:name=".UsuariosActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />
        <activity
            android:name=".ProveedoresActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <!-- Historial de Auditoría -->
        <activity
            android:name=".RegistrosActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <!-- Informe de Stock -->
        <activity
            android:name=".InformeStockActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <!-- Mapa y Ruta GPS a Empresa -->
        <activity
            android:name=".MapaRutaActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <!-- FileProvider para Exportar Informes (CSV/TXT) -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
    </application>

</manifest>