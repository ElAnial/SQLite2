<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="8dp"
    app:cardBackgroundColor="@color/card_bg"
    app:cardCornerRadius="12dp"
    app:cardElevation="1dp"
    app:strokeWidth="0dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <!-- SKU Badge -->
            <TextView
                android:id="@+id/tvItemSku"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="#E3F2FD"
                android:paddingHorizontal="8dp"
                android:paddingVertical="3dp"
                android:text="SKU-001"
                android:textColor="@color/primary"
                android:textSize="12sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvItemCategoria"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:text="Electrónica"
                android:textColor="@color/text_secondary"
                android:textSize="12sp" />

            <!-- Alerta de Bajo Stock -->
            <TextView
                android:id="@+id/tvItemBajoStockAlert"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="#FFEBEE"
                android:paddingHorizontal="8dp"
                android:paddingVertical="3dp"
                android:text="¡STOCK BAJO!"
                android:textColor="@color/btn_delete"
                android:textSize="11sp"
                android:textStyle="bold"
                android:visibility="gone" />

            <!-- Badge Deshabilitado / Sin Stock Inmediato -->
            <TextView
                android:id="@+id/tvItemDeshabilitadoAlert"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:background="#FFCDD2"
                android:paddingHorizontal="8dp"
                android:paddingVertical="3dp"
                android:text="DESHABILITADO"
                android:textColor="#B71C1C"
                android:textSize="11sp"
                android:textStyle="bold"
                android:visibility="gone" />
        </LinearLayout>

        <!-- Nombre Producto -->
        <TextView
            android:id="@+id/tvItemNombre"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="Nombre del Producto"
            android:textColor="@color/text_primary"
            android:textSize="16sp"
            android:textStyle="bold" />

        <!-- Código de barras (si existe) -->
        <TextView
            android:id="@+id/tvItemCodigoBarras"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="CB: 7891234567890"
            android:textColor="@color/text_secondary"
            android:textSize="12sp"
            android:visibility="gone" />

        <!-- Stock Actual, Unidad y Mínimo -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tvItemStockActual"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Stock: 15 u."
                android:textColor="@color/text_primary"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/tvItemUnidadMedida"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:text="(Unidad)"
                android:textColor="@color/text_secondary"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/tvItemStockMinimo"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:layout_weight="1"
                android:text="Mínimo: 5 u."
                android:textColor="@color/text_secondary"
                android:textSize="13sp" />

            <!-- Botón inmediato de Deshabilitar / Habilitar -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnItemToggleEstado"
                style="@style/Widget.Material3.Button.TonalButton"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:minHeight="0dp"
                android:paddingHorizontal="10dp"
                android:paddingVertical="4dp"
                android:textSize="11sp"
                android:text="Deshabilitar"
                app:cornerRadius="8dp" />
        </LinearLayout>

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>
